rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 共通の関数 ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    // --- users ---
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isTeacher());

      // 保護者の初回登録：未使用の招待コードを、同じバッチで自分が使用済みにしているときだけ
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'name', 'studentIds', 'inviteCode'])
        && request.resource.data.role == 'parent'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.studentIds == []
        && request.resource.data.inviteCode is string
        && get(invitePath(request.resource.data.inviteCode)).data.used == false
        && getAfter(invitePath(request.resource.data.inviteCode)).data.usedBy == uid;

      // 通知のトークンを保存する：自分の users の fcmTokens だけを書き換えられる（端末ごとに1つ。多くても10台まで）
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens'])
        && request.resource.data.fcmTokens is list
        && request.resource.data.fcmTokens.size() <= 10;
    }

    // --- invites（招待コード） ---
    match /invites/{code} {
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['used', 'usedBy', 'createdAt'])
        && request.resource.data.used == false
        && request.resource.data.usedBy == null
        && request.resource.data.createdAt == request.time;

      // コードを知っていれば1件は読める（登録前の確認用）。一覧は先生だけ
      allow get: if true;
      allow list: if isTeacher();

      // 使用済みにする：未使用→使用済み、usedBy は自分、同じバッチで自分の users を作っているときだけ
      allow update: if isSignedIn()
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCode == code;
    }

        // --- students（生徒と契約内容） ---
    function isValidStudent(data) {
      return data.keys().hasOnly(['name', 'color', 'parentUid', 'regularSlots', 'rates'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 50
        && data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$')
        && (data.parentUid == null || data.parentUid is string)
        && data.regularSlots is list && data.regularSlots.size() <= 7
        && data.rates is map
        && data.rates.keys().hasOnly(['regularFee', 'regularMinutes', 'hourlyRate', 'unitMinutes'])
        && data.rates.regularFee is int && data.rates.regularFee >= 0
        && data.rates.regularMinutes is int && data.rates.regularMinutes > 0
        && data.rates.hourlyRate is int && data.rates.hourlyRate >= 0
        && data.rates.unitMinutes is int && data.rates.unitMinutes > 0;
    }

    match /students/{studentId} {
      // 先生は全員分、保護者は自分の子だけ読める
      allow read: if isTeacher()
        || (isSignedIn() && resource.data.parentUid == request.auth.uid);
      allow create, update: if isTeacher() && isValidStudent(request.resource.data);
      allow delete: if isTeacher();
    }

    // --- lessons（1コマずつの予定と実績） ---
    match /lessons/{lessonId} {
      // 自分の子のコマか（保護者用）
      function isOwnLesson() {
        return isSignedIn() && resource.data.parentUid == request.auth.uid;
      }

      // 予定 → 休み（保護者が休みにする）
      function isParentCancel() {
        return resource.data.status == 'scheduled'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == 'parent';
      }

      // 休み → 予定（保護者が自分で休みにしたコマだけ戻せる）
      function isParentRestore() {
        return resource.data.status == 'cancelled'
          && resource.data.cancelledBy == 'parent'
          && request.resource.data.status == 'scheduled'
          && request.resource.data.cancelledBy == null;
      }

      // 先生は全部、保護者は自分の子のコマだけ読める
      allow read: if isTeacher() || isOwnLesson();

      // 先生は何でも書ける
      allow write: if isTeacher();

      // 保護者は、自分の子のコマの「休み」と「休みの取り消し」だけ
      allow update: if isOwnLesson()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy'])
        && (isParentCancel() || isParentRestore());
    }

    // --- availabilities（先生の出勤可能枠） ---
    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTime(value) {
      return value is string && value.matches('^[0-2][0-9]:[0-5][0-9]$');
    }

    match /availabilities/{availabilityId} {
      // 保護者も空き枠を見て申請するので、ログインしていればだれでも読める
      allow read: if isSignedIn();

      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['date', 'start', 'end'])
        && isDate(request.resource.data.date)
        && isTime(request.resource.data.start)
        && isTime(request.resource.data.end)
        && request.resource.data.start < request.resource.data.end;

      allow delete: if isTeacher();
    }

    // --- requests（追加コマ・振替の申請） ---
    match /requests/{requestId} {
      // 振替元のコマ：自分の子の、休みにしたコマか
      function isMakeupSource(data) {
        let lesson = get(/databases/$(database)/documents/lessons/$(data.makeupForId)).data;
        return data.makeupForId is string
          && lesson.studentId == data.studentId
          && lesson.parentUid == request.auth.uid
          && lesson.status == 'cancelled';
      }

      // 保護者の新しい申請として正しいか
      function isValidNewRequest(data) {
        let slot = get(/databases/$(database)/documents/availabilities/$(data.availabilityId)).data;
        let student = get(/databases/$(database)/documents/students/$(data.studentId)).data;
        return data.keys().hasOnly(['studentId', 'parentUid', 'availabilityId', 'type', 'date', 'start', 'end',
                                    'makeupForId', 'status', 'reason', 'lessonId', 'createdAt'])
          // だれの申請か：自分の子についての申請だけ
          && data.parentUid == request.auth.uid
          && student.parentUid == request.auth.uid
          // 時間：選んだ枠の日付と同じで、枠の中に収まっている
          && isTime(data.start) && isTime(data.end)
          && data.start < data.end
          && data.date == slot.date
          && slot.start <= data.start
          && data.end <= slot.end
          // 種類：追加コマなら振替元なし、振替なら振替元のコマが正しい
          && ((data.type == 'extra' && data.makeupForId == null)
            || (data.type == 'makeup' && isMakeupSource(data)))
          // 作った直後の状態
          && data.status == 'pending'
          && data.reason == null
          && data.lessonId == null
          && data.createdAt == request.time;
      }

      // 先生は全部、保護者は自分の申請だけ読める
      allow read: if isTeacher()
        || (isSignedIn() && resource.data.parentUid == request.auth.uid);

      allow create: if isSignedIn() && isValidNewRequest(request.resource.data);

      // 承認・拒否は先生だけ
      allow update, delete: if isTeacher();
    }

    // --- exams（テスト日程） ---
    match /exams/{examId} {
      // 先生は全部、保護者は自分の子のテストだけ読める
      allow read: if isTeacher()
        || (isSignedIn() && resource.data.parentUid == request.auth.uid);

      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['studentId', 'parentUid', 'name', 'startDate', 'endDate'])
        && request.resource.data.studentId is string
        && (request.resource.data.parentUid == null || request.resource.data.parentUid is string)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && isDate(request.resource.data.startDate)
        && isDate(request.resource.data.endDate)
        && request.resource.data.startDate <= request.resource.data.endDate;

      allow delete: if isTeacher();
    }

    // --- records（授業記録。ドキュメントID = コマのID） ---
    match /records/{recordId} {
      // 先生は全部、保護者は自分の子の記録だけ読める
      allow read: if isTeacher()
        || (isSignedIn() && resource.data.parentUid == request.auth.uid);

      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['studentId', 'parentUid', 'lessonId', 'date', 'condition', 'homework'])
        && request.resource.data.studentId is string
        && (request.resource.data.parentUid == null || request.resource.data.parentUid is string)
        && request.resource.data.lessonId == recordId
        && isDate(request.resource.data.date)
        && request.resource.data.condition is string
        && request.resource.data.condition.size() <= 2000
        && request.resource.data.homework is string
        && request.resource.data.homework.size() <= 2000;

      allow delete: if isTeacher();
    }

    // --- testResults（テスト・模試の結果） ---
    match /testResults/{resultId} {
      // 先生は全部、保護者は自分の子の結果だけ読める
      allow read: if isTeacher()
        || (isSignedIn() && resource.data.parentUid == request.auth.uid);

      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['studentId', 'parentUid', 'kind', 'name', 'date', 'subjects', 'judgements'])
        && request.resource.data.studentId is string
        && (request.resource.data.parentUid == null || request.resource.data.parentUid is string)
        && request.resource.data.kind in ['regular', 'mock']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && isDate(request.resource.data.date)
        && request.resource.data.subjects is list
        && request.resource.data.subjects.size() > 0
        && request.resource.data.subjects.size() <= 15
        && request.resource.data.judgements is list
        && request.resource.data.judgements.size() <= 10;

      allow delete: if isTeacher();
    }

    // --- chats/{studentId}/messages（メッセージ。生徒ごとのチャット） ---
    match /chats/{studentId}/messages/{messageId} {
      // この生徒の保護者か（パスの studentId から生徒を読んで確かめる）
      function isParentOfStudent() {
        return isSignedIn()
          && get(/databases/$(database)/documents/students/$(studentId)).data.parentUid == request.auth.uid;
      }

      // チャットに参加できる人：先生と、この生徒の保護者
      function isMember() {
        return isTeacher() || isParentOfStudent();
      }

      // 自分の役割と senderRole が合っているか（先生は 'teacher'、保護者は 'parent'）
      function isMyRole(role) {
        return (isTeacher() && role == 'teacher') || (!isTeacher() && role == 'parent');
      }

      allow read: if isMember();

      // 送信：自分の名前で、作った直後の状態で
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['senderUid', 'senderRole', 'text', 'createdAt', 'readAt'])
        && request.resource.data.senderUid == request.auth.uid
        && isMyRole(request.resource.data.senderRole)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.readAt == null;

      // 既読にする：相手が送った、まだ読んでいないメッセージの readAt だけを、サーバーの時刻にする
      allow update: if isMember()
        && !isMyRole(resource.data.senderRole)
        && resource.data.readAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
    }
  }
}
