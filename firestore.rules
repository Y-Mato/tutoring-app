rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 共通の関数 ---
    function isSignedIn() {
      return request.auth != null;
    }

    // 自分の users ドキュメントの role が teacher か
    function isTeacher() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // --- users ---
    match /users/{uid} {
      // 本人と先生だけ読める
      allow read: if isSignedIn() && (request.auth.uid == uid || isTeacher());
    }

    // --- invites（招待コード） ---
    match /invites/{code} {
      // 先生だけが、決まった形で作れる
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['used', 'usedBy', 'createdAt'])
        && request.resource.data.used == false
        && request.resource.data.usedBy == null
        && request.resource.data.createdAt == request.time;

      // 今は先生だけ読める（5b で保護者用のルールを足す）
      allow read: if isTeacher();
    }
  }
}
